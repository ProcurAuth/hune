root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,hcl,html,css,js,mjs,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# The tests compare the exact bytes of these files. Some have no final line end or keep spaces at a line end on purpose.
[{fuzz/**,tests/fixtures/**,tests/frontend/vectors/**,tests/golden/**,vendor/**,web/css/vendor/**,web/js/vendor/**}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
