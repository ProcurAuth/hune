  {"name":"limit with end last keeps the last rows","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"limit","count":2,"end":"last"},"expect":[[{"n":"x","k":"number","v":[3,2]},{"n":"k","k":"number","v":[4,5]}]]},
