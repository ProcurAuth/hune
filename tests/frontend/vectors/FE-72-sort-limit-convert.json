  {"name":"sort a text down: null last","frames":[[{"name":"s","kind":"text","values":["b","B","a","10","9",null,""]},{"name":"k","kind":"number","values":[1,2,3,4,5,6,7]}]],"transform":{"kind":"sort_by","sort":[{"field":"s","desc":true}]},"expect":[[{"n":"s","k":"text","v":["b","B","a","9","10","",null]},{"n":"k","k":"number","v":[1,2,3,5,4,7,6]}]]},
