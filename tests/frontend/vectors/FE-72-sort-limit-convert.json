  {"name":"sort a number up: the null comes last","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"sort_by","sort":[{"field":"x","desc":false}]},"expect":[[{"n":"x","k":"number","v":[1,2,3,3,null]},{"n":"k","k":"number","v":[3,5,1,4,2]}]]},
  {"name":"sort a number down: the null comes last","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"sort_by","sort":[{"field":"x","desc":true}]},"expect":[[{"n":"x","k":"number","v":[3,3,2,1,null]},{"n":"k","k":"number","v":[1,4,5,3,2]}]]},
  {"name":"the sort is stable for equal keys","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"sort_by","sort":[{"field":"x","desc":false}]},"expect":[[{"n":"x","k":"number","v":[1,2,3,3,null]},{"n":"k","k":"number","v":[3,5,1,4,2]}]]},
  {"name":"sort two keys","frames":[[{"name":"host","kind":"text","values":["a","b","a","c"]},{"name":"x","kind":"number","values":[1,null,3,4]},{"name":"y","kind":"number","values":[10,20,null,40]},{"name":"z","kind":"number","values":[100,200,300,400]}]],"transform":{"kind":"sort_by","sort":[{"field":"host","desc":false},{"field":"z","desc":true}]},"expect":[[{"n":"host","k":"text","v":["a","a","b","c"]},{"n":"x","k":"number","v":[3,1,null,4]},{"n":"y","k":"number","v":[null,10,20,40]},{"n":"z","k":"number","v":[300,100,200,400]}]]},
  {"name":"a key that is not a field is ignored","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"sort_by","sort":[{"field":"nope","desc":false}]},"expect":[[{"n":"x","k":"number","v":[3,null,1,3,2]},{"n":"k","k":"number","v":[1,2,3,4,5]}]]},
  {"name":"a key that is not a field next to a field","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"sort_by","sort":[{"field":"nope","desc":false},{"field":"x","desc":false}]},"expect":[[{"n":"x","k":"number","v":[1,2,3,3,null]},{"n":"k","k":"number","v":[3,5,1,4,2]}]]},
