  {"name":"limit 0 with end last","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}]],"transform":{"kind":"limit","count":0,"end":"last"},"expect":[[{"n":"x","k":"number","v":[]},{"n":"k","k":"number","v":[]}]]},
  {"name":"limit each frame alone","frames":[[{"name":"x","kind":"number","values":[3,null,1,3,2]},{"name":"k","kind":"number","values":[1,2,3,4,5]}],[{"name":"x","kind":"number","values":[5,2,1]}]],"transform":{"kind":"limit","count":1,"end":"first"},"expect":[[{"n":"x","k":"number","v":[3]},{"n":"k","k":"number","v":[1]}],[{"n":"x","k":"number","v":[5]}]]},
