  {"name":"join: no time field is an error","frames":[[{"name":"k","kind":"text","values":["a","b"]},{"name":"x","kind":"number","values":[1,2]}],[{"name":"k","kind":"text","values":["b","c"]},{"name":"y","kind":"number","values":[20,30]}]],"transform":{"kind":"join_by_field","field":null,"mode":"outer"},"expect":{"error":"The transform join_by_field failed: a frame has no time field"}},
