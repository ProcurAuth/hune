  {"name":"join inner keeps the keys of all frames","frames":[[{"name":"k","kind":"number","values":[3,1,2]},{"name":"a","kind":"number","values":[1,2,9]}],[{"name":"k","kind":"number","values":[2,3,1]},{"name":"b","kind":"number","values":[20,30,10]}]],"transform":{"kind":"join_by_field","field":"k","mode":"inner"},"expect":[[{"n":"k","k":"number","v":[3,1,2]},{"n":"a","k":"number","v":[1,2,9]},{"n":"b","k":"number","v":[30,10,20]}]]},
  {"name":"join inner: equal keys multiply, the first frame is the slowest index","frames":[[{"name":"k","kind":"number","values":[1,1]},{"name":"a","kind":"number","values":[1,2]}],[{"name":"k","kind":"number","values":[1,1]},{"name":"b","kind":"number","values":[10,20]}]],"transform":{"kind":"join_by_field","field":"k","mode":"inner"},"expect":[[{"n":"k","k":"number","v":[1,1,1,1]},{"n":"a","k":"number","v":[1,1,2,2]},{"n":"b","k":"number","v":[10,20,10,20]}]]},
  {"name":"join inner with three frames","frames":[[{"name":"k","kind":"number","values":[1,1]},{"name":"a","kind":"number","values":[1,2]}],[{"name":"k","kind":"number","values":[1,2]},{"name":"b","kind":"number","values":[10,20]}],[{"name":"k","kind":"number","values":[1,1]},{"name":"c","kind":"number","values":[100,200]}]],"transform":{"kind":"join_by_field","field":"k","mode":"inner"},"expect":[[{"n":"k","k":"number","v":[1,1,1,1]},{"n":"a","k":"number","v":[1,1,2,2]},{"n":"b","k":"number","v":[10,10,10,10]},{"n":"c","k":"number","v":[100,200,100,200]}]]},
