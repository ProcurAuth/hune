  {"name":"merge: an empty frame is not counted","frames":[[{"name":"k","kind":"text","values":["a","b"]},{"name":"x","kind":"number","values":[1,2]}],[]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","b"]},{"n":"x","k":"number","v":[1,2]}],[]]},
