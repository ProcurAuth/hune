  {"name":"join: one frame does not change","frames":[[{"name":"k","kind":"text","values":["a","b"]},{"name":"x","kind":"number","values":[1,2]}]],"transform":{"kind":"join_by_field","field":"k","mode":"outer"},"expect":[[{"n":"k","k":"text","v":["a","b"]},{"n":"x","k":"number","v":[1,2]}]]},
