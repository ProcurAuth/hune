{
 "note": "Hand-written inputs. The expected output was read and checked against 9.21a by the author (FE numbers of milestone F, wave 3).",
 "cases": [
  {"name":"merge: a field of all frames is the key","frames":[[{"name":"k","kind":"text","values":["a","b"]},{"name":"x","kind":"number","values":[1,2]}],[{"name":"k","kind":"text","values":["b","c"]},{"name":"y","kind":"number","values":[20,30]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","b","c"]},{"n":"x","k":"number","v":[1,2,null]},{"n":"y","k":"number","v":[null,20,30]}]]},
  {"name":"merge: a row with no conflict joins","frames":[[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[1]}],[{"name":"k","kind":"text","values":["a"]},{"name":"y","kind":"number","values":[2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a"]},{"n":"x","k":"number","v":[1]},{"n":"y","k":"number","v":[2]}]]},
  {"name":"merge: a conflict makes a new row","frames":[[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[1]}],[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","a"]},{"n":"x","k":"number","v":[1,2]}]]},
  {"name":"merge: a null in the earlier row never conflicts","frames":[[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[null]}],[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[5]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","a"]},{"n":"x","k":"number","v":[null,5]}]]},
  {"name":"merge: a null in the new row conflicts with a value","frames":[[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[5]}],[{"name":"k","kind":"text","values":["a"]},{"name":"x","kind":"number","values":[null]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","a"]},{"n":"x","k":"number","v":[5,null]}]]},
  {"name":"merge: equal rows of one frame join","frames":[[{"name":"k","kind":"text","values":["a","a"]},{"name":"x","kind":"number","values":[1,1]}],[{"name":"k","kind":"text","values":["b"]},{"name":"x","kind":"number","values":[2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","b"]},{"n":"x","k":"number","v":[1,2]}]]},
  {"name":"merge: one frame does not change","frames":[[{"name":"k","kind":"text","values":["a","b"]},{"name":"x","kind":"number","values":[1,2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["a","b"]},{"n":"x","k":"number","v":[1,2]}]]},
