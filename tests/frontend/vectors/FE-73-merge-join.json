  {"name":"join after partition on the key field","frames":[[{"name":"h","kind":"text","values":["a","b"]},{"name":"v","kind":"number","values":[1,2]}]],"transform":[{"kind":"partition_by_values","fields":["h"],"keep_fields":true},{"kind":"join_by_field","field":"h","mode":"outer"}],"expect":[[{"n":"h","k":"text","v":["a","b"]},{"n":"v","k":"number","v":[1,null],"l":{"h":"a"}},{"n":"v","k":"number","v":[null,2],"l":{"h":"b"}}]]}
