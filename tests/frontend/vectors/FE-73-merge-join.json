  {"name":"join outer: the last row of a key wins","frames":[[{"name":"k","kind":"number","values":[1,1]},{"name":"a","kind":"number","values":[1,2]}],[{"name":"k","kind":"number","values":[1]},{"name":"b","kind":"number","values":[9]}]],"transform":{"kind":"join_by_field","field":"k","mode":"outer"},"expect":[[{"n":"k","k":"number","v":[1]},{"n":"a","k":"number","v":[2]},{"n":"b","k":"number","v":[9]}]]},
