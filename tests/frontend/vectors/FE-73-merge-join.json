  {"name":"merge: the order is the order of first appearance","frames":[[{"name":"k","kind":"text","values":["c","a"]},{"name":"x","kind":"number","values":[1,2]}],[{"name":"k","kind":"text","values":["b","a"]},{"name":"x","kind":"number","values":[3,2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"text","v":["c","a","b"]},{"n":"x","k":"number","v":[1,2,3]}]]},
  {"name":"merge: the kind of the first frame","frames":[[{"name":"k","kind":"number","values":[1]},{"name":"x","kind":"number","values":[1]}],[{"name":"k","kind":"number","values":[2]},{"name":"y","kind":"number","values":[2]}]],"transform":{"kind":"merge"},"expect":[[{"n":"k","k":"number","v":[1,2]},{"n":"x","k":"number","v":[1,null]},{"n":"y","k":"number","v":[null,2]}]]},
