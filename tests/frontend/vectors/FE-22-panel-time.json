{
  "description": "FE-22: the range of a panel with a time override and its note (9.8b). `dash` is the range of the dashboard (texts and the times of `now`).",
  "ranges": [
    { "name": "time_from now-24h", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now-24h" }, "from": "2026-11-08T14:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "time_shift 1d alone moves the dashboard range", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "1d" }, "from": "2026-11-08T08:30:00.000Z", "to": "2026-11-08T14:30:00.000Z" },
    { "name": "both: the shift comes after time_from", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now-24h", "time_shift": "1d" }, "from": "2026-11-07T14:30:00.000Z", "to": "2026-11-08T14:30:00.000Z" },
    { "name": "now/d and 1d: the start of yesterday to now minus one day", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/d", "time_shift": "1d" }, "from": "2026-11-08T00:00:00.000Z", "to": "2026-11-08T14:30:00.000Z" },
    { "name": "now-5d/d", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now-5d/d" }, "from": "2026-11-04T00:00:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "now/w starts on Monday", "now": "2026-11-11T09:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/w" }, "from": "2026-11-09T00:00:00.000Z", "to": "2026-11-11T09:00:00.000Z" },
    { "name": "now/M and now/y", "now": "2026-11-11T09:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/M" }, "from": "2026-11-01T00:00:00.000Z", "to": "2026-11-11T09:00:00.000Z" },
    { "name": "now/y", "now": "2026-11-11T09:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/y" }, "from": "2026-01-01T00:00:00.000Z", "to": "2026-11-11T09:00:00.000Z" },
    { "name": "an absolute dashboard range: time_from does nothing", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["1794211200000", "1794214800000"], "query": { "time_from": "now-24h" }, "from": "2026-11-09T08:00:00.000Z", "to": "2026-11-09T09:00:00.000Z" },
    { "name": "an absolute dashboard range: time_shift applies", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["1794211200000", "1794214800000"], "query": { "time_shift": "1h" }, "from": "2026-11-09T07:00:00.000Z", "to": "2026-11-09T08:00:00.000Z" },
    { "name": "an absolute dashboard range: time_from does nothing and the shift applies", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["1794211200000", "1794214800000"], "query": { "time_from": "now-24h", "time_shift": "1h" }, "from": "2026-11-09T07:00:00.000Z", "to": "2026-11-09T08:00:00.000Z" },
    { "name": "one end is a now text: time_from applies and `to` is now", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["1794211200000", "now"], "query": { "time_from": "now-1h" }, "from": "2026-11-09T13:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "the other end is a now text", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-2h", "1794254400000"], "query": { "time_from": "now-1h" }, "from": "2026-11-09T13:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "now/d at the first millisecond of the day: to is from + 1", "now": "2026-11-09T00:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/d" }, "from": "2026-11-09T00:00:00.000Z", "to": "2026-11-09T00:00:00.001Z" },
    { "name": "now/d at the first millisecond of the day in Tokyo", "now": "2026-11-08T15:00:00.000Z", "zone": "Asia/Tokyo", "dash": ["now-6h", "now"], "query": { "time_from": "now/d" }, "from": "2026-11-08T15:00:00.000Z", "to": "2026-11-08T15:00:00.001Z" },
    { "name": "Paris, the day of the change to summer time: calendar shift of 1d", "now": "2026-03-29T10:00:00.000Z", "zone": "Europe/Paris", "dash": ["now-6h", "now"], "query": { "time_from": "now/d", "time_shift": "1d" }, "from": "2026-03-27T23:00:00.000Z", "to": "2026-03-28T11:00:00.000Z" },
    { "name": "Paris, the day of the change: the start of the day is 23:00Z of the day before", "now": "2026-03-29T10:00:00.000Z", "zone": "Europe/Paris", "dash": ["now-6h", "now"], "query": { "time_from": "now/d" }, "from": "2026-03-28T23:00:00.000Z", "to": "2026-03-29T10:00:00.000Z" },
    { "name": "a fixed shift in hours is 24 hours on a day of 23 hours", "now": "2026-03-29T10:00:00.000Z", "zone": "Europe/Paris", "dash": ["now-6h", "now"], "query": { "time_shift": "24h" }, "from": "2026-03-28T04:00:00.000Z", "to": "2026-03-28T10:00:00.000Z" },
    { "name": "a shift of 1w and 1M and 1y are calendar units", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "1w" }, "from": "2026-11-02T08:30:00.000Z", "to": "2026-11-02T14:30:00.000Z" },
    { "name": "1M", "now": "2026-03-31T12:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "1M" }, "from": "2026-02-28T06:00:00.000Z", "to": "2026-02-28T12:00:00.000Z" },
    { "name": "a text that breaks the grammar leaves the range of the dashboard (now/Q)", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now/Q" }, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "now alone is not a time_from", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_from": "now" }, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "a sign in the shift is not valid: the range stays", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "-1d" }, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "1d/d is not a shift", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "1d/d" }, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "no override", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "hide_time_override": true }, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "no query (a reuse panel)", "now": "2026-11-09T14:30:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": null, "from": "2026-11-09T08:30:00.000Z", "to": "2026-11-09T14:30:00.000Z" },
    { "name": "a range below 0 gives the error", "now": "1970-02-01T00:00:00.000Z", "zone": "utc", "dash": ["now-6h", "now"], "query": { "time_shift": "2M" }, "error": true },
    { "name": "a shift of the start below 1970", "now": "1970-01-01T05:00:00.000Z", "zone": "utc", "dash": ["now-1h", "now"], "query": { "time_shift": "1h" }, "from": "1970-01-01T03:00:00.000Z", "to": "1970-01-01T04:00:00.000Z" },
    { "name": "a shift of the start below 1970 (error)", "now": "1970-01-01T05:00:00.000Z", "zone": "utc", "dash": ["now-1h", "now"], "query": { "time_shift": "5h" }, "error": true },
    { "name": "time_from below 1970 gives the error", "now": "1970-01-01T05:00:00.000Z", "zone": "utc", "dash": ["now-1h", "now"], "query": { "time_from": "now-1d" }, "error": true }
  ],
