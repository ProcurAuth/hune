    ]
   },
   "expect": [
    "a",
    "b"
   ]
  },
  {
   "name": "regex on a number",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "regex",
       "pattern": "^1$"
      }
     }
    ]
   },
   "expect": [
    "a"
   ]
  },
  {
   "name": "match all",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "all",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "greater",
       "value": 0
      }
     },
     {
      "field": "name",
      "matcher": {
       "kind": "regex",
       "pattern": "d"
      }
     }
    ]
   },
   "expect": [
    "d"
   ]
  },
  {
   "name": "match any with two filters",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "equal",
       "value": 0
      }
     },
     {
      "field": "name",
      "matcher": {
       "kind": "equal",
       "value": "d"
      }
     }
    ]
   },
   "expect": [
    "b",
    "d"
   ]
  },
  {
   "name": "exclude all",
   "spec": {
    "kind": "filter_by_value",
    "mode": "exclude",
    "match": "all",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "greater",
       "value": 0
      }
     },
     {
      "field": "name",
      "matcher": {
       "kind": "equal",
       "value": "a"
      }
     }
    ]
   },
   "expect": [
    "b",
    "c",
    "d"
   ]
  },
  {
