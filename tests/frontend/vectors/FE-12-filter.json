   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "zz",
      "matcher": {
       "kind": "is_null"
      }
     }
    ]
   },
   "expect": []
  },
  {
   "name": "unknown field never passes, exclude",
   "spec": {
    "kind": "filter_by_value",
    "mode": "exclude",
    "match": "any",
    "filters": [
     {
      "field": "zz",
      "matcher": {
       "kind": "is_null"
      }
     }
    ]
   },
   "expect": [
    "a",
    "b",
    "c",
    "d"
   ]
  },
  {
   "name": "unknown field with match all",
   "spec": {
    "kind": "filter_by_value",
