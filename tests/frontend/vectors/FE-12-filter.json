{
 "id": "FE-12",
 "cols": [
  {
   "name": "name",
   "kind": "text",
   "values": [
    "a",
    "b",
    "c",
    "d"
   ]
  },
  {
   "name": "status",
   "kind": "number",
   "values": [
    1,
    0,
    null,
    2
   ]
  }
 ],
 "cases": [
  {
   "name": "exclude any is_null",
   "spec": {
    "kind": "filter_by_value",
    "mode": "exclude",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "is_null"
      }
     }
    ]
   },
   "expect": [
    "a",
    "b",
    "d"
   ]
  },
  {
   "name": "include any is_not_null",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "is_not_null"
      }
     }
    ]
   },
   "expect": [
    "a",
    "b",
    "d"
   ]
  },
  {
   "name": "equal number",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "equal",
       "value": 1
      }
     }
    ]
   },
   "expect": [
    "a"
   ]
  },
  {
   "name": "equal loose text",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "equal",
       "value": "1"
      }
     }
    ]
   },
   "expect": [
    "a"
   ]
  },
  {
   "name": "equal 0 does not match null",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "equal",
       "value": 0
      }
     }
    ]
   },
   "expect": [
    "b"
   ]
  },
  {
   "name": "not_equal",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "not_equal",
       "value": 1
      }
     }
    ]
   },
   "expect": [
    "b",
    "c",
    "d"
   ]
  },
  {
   "name": "greater",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "greater",
       "value": 0
      }
     }
    ]
   },
   "expect": [
    "a",
    "d"
   ]
  },
  {
   "name": "greater_or_equal",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "greater_or_equal",
       "value": 1
      }
     }
    ]
   },
   "expect": [
    "a",
    "d"
   ]
  },
  {
   "name": "lower counts null as 0",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "lower",
       "value": 1
      }
     }
    ]
   },
   "expect": [
    "b",
    "c"
   ]
  },
  {
   "name": "lower_or_equal",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "lower_or_equal",
       "value": 0
      }
     }
    ]
   },
   "expect": [
    "b",
    "c"
   ]
  },
  {
   "name": "range excludes both bounds",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "status",
      "matcher": {
       "kind": "range",
       "from": 0,
       "to": 2
      }
     }
    ]
   },
   "expect": [
    "a"
   ]
  },
  {
   "name": "regex on the text form",
   "spec": {
    "kind": "filter_by_value",
    "mode": "include",
    "match": "any",
    "filters": [
     {
      "field": "name",
      "matcher": {
