    "include_all": false,
    "all_value": null,
    "sort": "none",
    "regex": "/^(?<value>\\d+)-(?<text>[a-z]+)$/",
    "default": []
   },
   "raw": [
    {
     "value": "10-abc",
     "text": "10-abc"
    },
    {
     "value": "x",
     "text": "nomatch"
