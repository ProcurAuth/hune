      { "uid": "u-ab-dash", "title": "a-b", "tags": ["a"], "state": "valid" },
      { "uid": "u-ab-dot", "title": "a.b", "tags": ["a"], "state": "valid" },
      { "uid": "u-ab-und", "title": "a_b", "tags": ["a"], "state": "valid" },
      { "uid": "u-ab", "title": "ab", "tags": ["a", "b"], "state": "valid" },
      { "uid": "u-beta", "title": "Beta", "tags": ["a", "b"], "state": "valid" },
      { "uid": "u-ea", "title": "ea", "tags": ["a", "b"], "state": "valid" },
      { "uid": "u-zz", "title": "ZZ", "tags": ["b"], "state": "valid" },
      { "uid": "u-eacute", "title": "Éa", "tags": ["a"], "state": "valid" },
      { "uid": "u-tie-2", "title": "tie", "tags": ["a"], "state": "valid" },
      { "uid": "u-tie-1", "title": "tie", "tags": ["a"], "state": "valid" },
      { "uid": "current", "title": "Current", "tags": ["a", "b"], "state": "valid" },
      { "uid": "broken", "title": "broken", "tags": [], "state": "invalid" },
      { "uid": "u-case", "title": "case", "tags": ["A"], "state": "valid" }
    ],
    "cases": [
      { "name": "one tag, the current dashboard is out, an invalid item is out, the tag is exact", "tags": ["a"], "uids": ["u-10", "u-9", "u-ab-sp", "u-ab-par", "u-ab-dash", "u-ab-dot", "u-ab-und", "u-ab", "u-beta", "u-ea", "u-tie-1", "u-tie-2", "u-eacute"] },
      { "name": "two tags are an AND", "tags": ["a", "b"], "uids": ["u-ab", "u-beta", "u-ea"] },
      { "name": "the order of the tags does not matter", "tags": ["b", "a"], "uids": ["u-ab", "u-beta", "u-ea"] },
      { "name": "no tag selects all the valid dashboards except the current one", "tags": [], "uids": ["u-10", "u-9", "u-ab-sp", "u-ab-par", "u-ab-dash", "u-ab-dot", "u-ab-und", "u-ab", "u-beta", "u-case", "u-ea", "u-tie-1", "u-tie-2", "u-zz", "u-eacute"] },
      { "name": "a tag that no item has", "tags": ["nope"], "uids": [] },
      { "name": "the comparison is exact", "tags": ["A"], "uids": ["u-case"] }
