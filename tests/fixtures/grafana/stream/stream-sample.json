{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "stream-sample",
    "namespace": "default",
    "annotations": {
      "grafana.app/folder": "stream"
    }
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-23": {
        "kind": "Panel",
        "spec": {
          "id": 23,
          "title": "Open Sessions",
          "description": "Sessions that are open at the end of the selected range. The scan starts 1h before the range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ClickHouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.5.1",
                        "queryType": "table",
                        "rawSql": "WITH\n    toDateTime64($__fromTime, 3, 'UTC') AS panel_from,\n    toDateTime64($__toTime, 3, 'UTC') AS panel_to,\n    panel_from - INTERVAL 1 HOUR AS scan_from,\n    sessions AS\n    (\n        SELECT\n            session_id,\n            countIf(event_type = 'session_start') AS starts,\n            countIf(event_type = 'session_end') AS ends,\n            maxIf(timestamp, event_type = 'session_start') AS started_at,\n            maxIf(timestamp, event_type = 'session_end') AS ended_at\n        FROM analytics.web_events\n        PREWHERE timestamp >= scan_from AND timestamp <= panel_to\n        WHERE event_type IN ('session_start', 'session_end')\n        GROUP BY session_id\n    )\nSELECT uniqExact(session_id) AS value\nFROM sessions\nWHERE starts > 0 AND (ends = 0 OR started_at > ended_at)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": true
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      },
      "panel-40": {
        "kind": "Panel",
        "spec": {
          "id": 40,
          "title": "Page Load Time p50 / p90 / p99",
          "description": "Duration of the page views with a status below 500.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ClickHouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "pluginVersion": "4.5.1",
                        "queryType": "timeseries",
                        "rawSql": "WITH aggregated AS\n(\n    SELECT\n        $__timeInterval(timestamp) AS time,\n        region,\n        quantiles(0.50, 0.90, 0.99)(toFloat64(duration_ms)) AS q\n    FROM analytics.web_events\n    WHERE $__timeFilter(timestamp)\n      AND event_type = 'page_view'\n      AND status < 500\n    GROUP BY time, region\n)\nSELECT\n    time,\n    concat(region, ' ', item.1) AS metric,\n    item.2 AS value\nFROM aggregated\nARRAY JOIN\n[\n    ('p50', q[1]),\n    ('p90', q[2]),\n    ('p99', q[3])\n] AS item\nORDER BY time, metric"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.2",
            "spec": {
              "options": {
                "annotations": {
                  "clustering": -1,
                  "multiLane": false
                },
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "displayName": "${__field.labels.metric}",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 7,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineStyle": {
                      "fill": "solid"
                    },
                    "lineWidth": 1,
                    "pointSize": 1,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "ms"
                },
                "overrides": [
                  {
                    "__systemRef": "hideSeriesFrom",
                    "matcher": {
                      "id": "byNames",
                      "options": {
                        "mode": "exclude",
                        "names": [
                          "eu p99",
                          "eu p50"
                        ],
                        "prefix": "All except:",
                        "readOnly": true
                      }
                    },
                    "properties": [
                      {
                        "id": "custom.hideFrom",
                        "value": {
                          "legend": false,
                          "tooltip": true,
                          "viz": true
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "transparent": true
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Traffic by Page",
          "description": "Requests, bytes and users for each page.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ClickHouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.5.1",
                        "queryType": "table",
                        "rawSql": "SELECT\n    page,\n    count() AS requests,\n    sum(bytes) AS bytes,\n    round(bytes / nullIf(requests, 0), 2) AS bytes_per_request,\n    uniqExact(visitor_id) AS users,\n    round(100.0 * bytes / nullIf(sum(bytes) OVER (), 0), 2) AS share_pct\nFROM analytics.web_events\nWHERE $__timeFilter(timestamp)\n  AND event_type = 'page_view'\nGROUP BY page\nORDER BY bytes DESC\nLIMIT 100"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "share_pct"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percent"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "scope": "series",
                      "options": "users"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 80
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "scope": "series",
                      "options": "bytes_per_request"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 141
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
