{
  "format_version": 3,
  "uid": "pg-main",
  "title": "PostgreSQL panels",
  "description": "Synthetic dashboard of the importer tests: one panel for each PostgreSQL row of 15.6.",
  "tags": [
    "synthetic",
    "postgres"
  ],
  "time": {
    "from": "now-6h",
    "to": "now",
    "timezone": "browser",
    "refresh": null
  },
  "cursor_sync": "off",
  "links": [],
  "variables": [
    {
      "kind": "query",
      "name": "host",
      "label": "Host",
      "hide": "none",
      "source": "analytics",
      "sql": [
        "SELECT DISTINCT host",
        "FROM metrics.node_load",
        "ORDER BY host"
      ],
      "multi": true,
      "include_all": true,
      "all_value": null,
      "refresh": "time_change",
      "sort": "alpha_asc",
      "regex": null,
      "default": [
        "$__all"
      ],
      "allow_custom_value": true
    }
  ],
  "sections": [
    {
      "title": null,
      "collapsed": false,
      "panels": [
        {
          "id": 1,
          "type": "table",
          "title": "Recent rows",
          "description": "",
          "transparent": false,
          "grid": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "data": {
            "query": {
              "source": "analytics",
              "format": "table",
              "sql": [
                "SELECT ts, host, load",
                "FROM metrics.node_load",
                "WHERE $__timeFilter(ts) AND host IN ($host)",
                "ORDER BY ts DESC",
                "LIMIT 100"
              ],
              "min_interval": null,
              "max_data_points": null
            }
          },
          "transforms": [],
          "fields": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "show_header": true,
            "sort": []
          },
          "links": []
        },
        {
          "id": 2,
          "type": "timeseries",
          "title": "Load by host",
          "description": "",
          "transparent": false,
          "grid": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "data": {
            "query": {
              "source": "analytics",
              "format": "time_series",
              "sql": [
                "SELECT $__timeGroupAlias(ts, $__interval), host, avg(load) AS load",
                "FROM metrics.node_load",
                "WHERE $__timeFilter(ts) AND host IN ($host)",
                "GROUP BY 1, host",
                "ORDER BY 1"
              ],
              "min_interval": null,
              "max_data_points": null
            }
          },
          "transforms": [],
          "fields": {
            "defaults": {},
            "overrides": []
