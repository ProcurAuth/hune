      "panels": [
        {
          "id": 1,
          "type": "table",
          "title": "Orders table",
          "description": "",
          "transparent": false,
          "grid": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "data": {
            "query": {
              "source": "events",
              "format": "table",
              "sql": [
                "{",
                "  \"collection\": \"orders\",",
                "  \"aggregate\": [",
                "    {\"$match\":{\"ts\":{\"$gte\":\"$__timeFrom\",\"$lte\":\"$__timeTo\"},\"host\":{\"$in\":\"${node:json}\"}}},",
                "    {\"$project\":{\"_id\":0,\"host\":1,\"load\":1}},",
                "    {\"$sort\":{\"host\":1}}",
                "  ]",
                "}"
              ],
              "min_interval": null,
              "max_data_points": null
            }
          },
          "transforms": [],
          "fields": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "show_header": true,
            "sort": []
          },
