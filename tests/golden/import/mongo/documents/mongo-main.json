        {
          "id": 2,
          "type": "timeseries",
          "title": "Load by host",
          "description": "",
          "transparent": false,
          "grid": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "data": {
            "query": {
              "source": "events",
              "format": "time_series",
              "sql": [
                "{",
                "  \"collection\": \"node_load\",",
                "  \"database\": \"analytics\",",
                "  \"aggregate\": [",
                "    {\"$match\":{\"ts\":{\"$gte\":\"$__timeFrom\",\"$lte\":\"$__timeTo\"},\"host\":{\"$in\":\"${node:json}\"}}},",
                "    {\"$group\":{\"_id\":{\"t\":{\"$dateTrunc\":{\"date\":\"$ts\",\"unit\":\"second\",\"binSize\":\"$__interval_s\"}},\"host\":\"$host\"},\"load\":{\"$avg\":\"$load\"}}},",
                "    {\"$project\":{\"_id\":0,\"time\":\"$_id.t\",\"host\":\"$_id.host\",\"load\":1}},",
                "    {\"$sort\":{\"time\":1}}",
                "  ]",
                "}"
              ],
              "min_interval": null,
              "max_data_points": null
            }
          },
          "transforms": [],
          "fields": {
            "defaults": {},
            "overrides": []
