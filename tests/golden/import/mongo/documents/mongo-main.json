{
  "format_version": 3,
  "uid": "mongo-main",
  "title": "MongoDB panels",
  "description": "Synthetic dashboard of the importer tests: one panel for each MongoDB row of 15.6.",
  "tags": [
    "synthetic",
    "mongodb"
  ],
  "time": {
    "from": "now-6h",
    "to": "now",
    "timezone": "browser",
    "refresh": null
  },
  "cursor_sync": "off",
  "links": [],
  "variables": [
    {
      "kind": "custom",
      "name": "node",
      "label": "Node",
      "hide": "none",
      "options": [
        {
          "text": "node-a",
          "value": "node-a"
        },
        {
          "text": "node-b",
          "value": "node-b"
        },
        {
          "text": "node-c",
          "value": "node-c"
        }
      ],
      "multi": true,
      "include_all": true,
      "all_value": null,
      "default": [
        "$__all"
      ]
    },
    {
      "kind": "custom",
      "name": "region",
      "label": "Region",
      "hide": "none",
      "options": [
        {
          "text": "eu",
          "value": "eu"
        },
        {
          "text": "us",
          "value": "us"
        }
      ],
