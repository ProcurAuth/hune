    "macro:$__timeFilter",
    "time:ms"
  ],
  "grafana": "12.4.2",
  "plugin": "grafana-postgresql-datasource (core)",
  "capture": "ds-query",
  "template": "SELECT v FROM t WHERE $__timeFilter(ts)",
  "variables": [],
  "values": {},
  "from_ms": 0,
  "to_ms": 1,
  "max_data_points": 1200,
  "min_interval": null,
  "min_interval_ms": null,
  "interval_ms": 1,
  "expected": "SELECT v FROM t WHERE ts BETWEEN '1970-01-01T00:00:00Z' AND '1970-01-01T00:00:00.001Z'",
  "sent_sql": "SELECT v FROM t WHERE $__timeFilter(ts)"
}
