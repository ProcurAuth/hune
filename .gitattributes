# Git stores each text file with LF line ends, and writes LF in the working tree on all systems.
* text=auto eol=lf

# Git never changes the bytes of these files.
*.png binary
*.webp binary
*.ico binary
*.gz binary
*.zip binary
*.woff2 binary

# Git never changes the bytes of the fuzz inputs. Some of them hold CR LF line ends on purpose.
fuzz/corpus/** -text
fuzz/regression/** -text

# Git never changes the bytes of these files. The tests compare their exact bytes, and the vendor lock files
# give the sha256 of each copied file.
vendor/** -text
web/css/vendor/** -text
web/js/vendor/** -text
tests/fixtures/** -text
tests/golden/** -text
tests/frontend/vectors/** -text
